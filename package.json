  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --config tests/playwright.config.ts --trace off",
    "test:serve": "TEST_WATCH=1 node tests/servers.mjs",
    "test:pack": "node fixtures/run.mjs",
    "check:package": "node fixtures/check-package.mjs",
    "test:modes": "node tests/modes/run.mjs",
    "test:components": "node playground/components/run.mjs",
    "conformance": "node conformance/run.mjs",
    "bench": "node bench/run.mjs"
  },
