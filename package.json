{
  "name": "ui-sdk-octane",
  "version": "0.0.1",
  "description": "An unofficial Octane adapter for UI SDK (@ui-sdk/core): render a primitive's parts as Octane components.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["src", "LICENSE", "NOTICE", "README.md"],
  "exports": {
    "./primitive": "./src/primitive.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs"
  },
  "peerDependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "octane": ">=0.16.7"
  },
  "devDependencies": {
    "@tsrx/oxc": "0.24.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "octane": "0.23.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "^8.0.16"
  }
}
